# ==========================================
# Sicodiet - Variables de Entorno
# ==========================================
# Copiar este archivo a .env y completar los valores

# --- Aplicación ---
NODE_ENV=production
PORT=3001

# --- Base de Datos ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=sicodiet
DB_PASSWORD=secret
DB_NAME=gestion_tambo
# DB_SSL=true  # activar solo si la DB no está en la misma red privada que el backend

# --- JWT ---
JWT_SECRET=cambia_esto_por_un_secreto_real
JWT_EXPIRES_IN=24h

# --- Frontend URL (CORS) ---
# Agregar URLs separadas por comas:
# - Backend local: http://localhost:3001
# - Red local: http://192.168.1.244:3001
# - Tunnel permanente: https://tu-app.tunnel.com
FRONTEND_URL=http://localhost:3001,http://192.168.1.244:3001

# --- Email (Password Reset) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_FROM="Sicodiet" <tu_email@gmail.com>
RESET_TOKEN_EXPIRY=1

# --- Push notifications (Web Push) ---
# Generar el par UNA sola vez con: node -e "console.log(require('web-push').generateVAPIDKeys())"
# y no volver a regenerarlo (invalidaria las suscripciones ya guardadas en push_subscriptions).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu_email@gmail.com

# --- Cifrado de cedula en reposo ---
# ENCRYPTION_KEY: clave AES-256 de 32 bytes en hex (64 caracteres). Generarla UNA
# sola vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# y guardarla en un lugar seguro ademas de Railway -- si se pierde, ninguna cedula
# cifrada se puede volver a leer y nadie puede loguearse.
# CEDULA_HASH_KEY: cualquier string secreto largo, usado para el HMAC con el que se
# busca la cedula por igualdad (login, chequeo de unicidad). No hace falta que sea
# hex ni de un largo especifico, pero no debe cambiarse una vez hay usuarios creados
# (si cambia, ningun login por cedula existente vuelve a matchear).
ENCRYPTION_KEY=
CEDULA_HASH_KEY=

# --- CAPTCHA (Cloudflare Turnstile) en registro y recuperacion de contraseña ---
# Secret key de https://dash.cloudflare.com/?to=/:account/turnstile (par del
# VITE_TURNSTILE_SITE_KEY del frontend). Sin esta variable, el backend no exige
# el token -- asi que en dev local se puede dejar vacia sin romper el flujo.
TURNSTILE_SECRET_KEY=
