# URL publica con la que se generan los links de invitacion (QR de Usuarios).
# Si no se define, se usa window.location.origin (el dominio desde el que se sirve la app).
# Fijala en produccion para que el link no dependa del host que sirvio la pagina
# (proxy, IP interna, tunnel, etc.) y sobreviva a un cambio de dominio.
VITE_APP_URL=https://sicodiet.com

# Cloudflare Turnstile (CAPTCHA en registro y recuperacion de contraseña).
# Sin esta variable, el widget no se renderiza y el backend tampoco exige el
# token -- asi que en dev local se puede dejar vacia sin romper el flujo.
# Crear el site key en https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=
